          {
            "speaker": "凌瑶",
            "text": "有。"
          },
          {
            "speaker": "陆昭",
            "text": "……明天我不会让她走的。"
          },
          {
            "speaker": "凌瑶",
            "text": "行。我信你。"
          }
        ]
