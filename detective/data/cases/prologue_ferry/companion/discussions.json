{
  "next_direction": {
    "rules": [
      {
        "when": {
          "all": [
            {
              "flag": "agui_confessed_mastermind"
            },
            {
              "evidence": "evidence_cargo_silver"
            },
            {
              "clue": "evidence_salvage_mark"
            },
            {
              "clue": "evidence_shen_connection"
            },
            {
              "clue": "evidence_dock_timing"
            },
            {
              "evidence": "evidence_drug_capsule_shell"
            },
            {
              "evidence": "evidence_tongue_herb_residue"
            },
            {
              "evidence": "evidence_oil_lock_residue"
            }
          ]
        },
        "lines": [
          {
            "speaker": "凌瑶",
            "text": "沈姑娘还在楼上吗？"
          }
        ]
      },
      {
        "when": {
          "all": [
            {
              "flag": "agui_confessed_mastermind"
            },
            {
              "not": {
                "evidence": "evidence_cargo_silver"
              }
            }
          ]
        },
        "lines": [
          {
            "speaker": "凌瑶",
            "text": "阿贵认了。那货银不知道在哪儿，下游那片。我总觉得有东西。"
          }
        ]
      },
      {
        "when": {
          "all": [
            {
              "flag": "agui_confessed_mastermind"
            },
            {
              "not": {
                "clue": "evidence_salvage_mark"
              }
            }
          ]
        },
        "lines": [
          {
            "speaker": "凌瑶",
            "text": "浅滩那边，昨晚天亮前有人去过。我睡前出去喝水，看见有火光，当时没在意。"
          }
        ]
      },
      {
        "when": {
          "all": [
            {
              "flag": "agui_confessed_mastermind"
            },
            {
              "not": {
                "clue": "evidence_shen_connection"
              }
            }
          ]
        },
        "lines": [
          {
            "speaker": "凌瑶",
            "text": "老范的赌债。他怎么欠进去的，我们都不知道。"
          }
        ]
      },
      {
        "when": {
          "all": [
            {
              "flag": "agui_confessed_mastermind"
            },
            {
              "any": [
                {
                  "not": {
                    "evidence": "evidence_drug_capsule_shell"
                  }
                },
                {
                  "not": {
                    "evidence": "evidence_tongue_herb_residue"
                  }
                },
                {
                  "not": {
                    "evidence": "evidence_oil_lock_residue"
                  }
                }
              ]
            }
          ]
        },
        "lines": [
          {
            "speaker": "凌瑶",
            "text": "周老板喝了一肚子油腻还赶夜船。你问没问他船上吃了什么？"
          }
        ]
      },
      {
        "when": {
          "all": [
            {
              "flag": "bladder_meaning_revised"
            },
            {
              "not_flag": "shen_confrontation_triggered"
            }
          ]
        },
        "lines": [
          {
            "speaker": "凌瑶",
            "text": "那个浮囊不是怕万一用的。它是给知道船会进水的人准备的。"
          }
        ]
      },
      {
        "when": {
          "all": [
            {
              "flag": "agui_confessed_mastermind"
            },
            {
              "not_flag": "shen_confrontation_triggered"
            }
          ]
        },
        "lines": [
          {
            "speaker": "凌瑶",
            "text": "阿贵说了，但他一个人不够。"
          },
          {
            "speaker": "陆昭",
            "text": "对。一个人说的话，谁都能说他是在攀咬。"
          },
          {
            "speaker": "凌瑶",
            "text": "嗯。我去看看浅滩那边。你去哪？"
          }
        ]
      },
      {
        "when": {
          "all": [
            {
              "flag": "self_cleared"
            },
            {
              "not": {
                "evidence": "evidence_no_blunt_trauma"
              }
            }
          ]
        },
        "lines": [
          {
            "speaker": "凌瑶",
            "text": "阿贵说你用铁器砸人。周老板身上有没有伤，我们去看了吗？"
          }
        ]
      },
      {
        "when": {
          "all": [
            {
              "flag": "self_cleared"
            },
            {
              "not": {
                "clue": "clue_fan_alibi_hole"
              }
            }
          ]
        },
        "lines": [
          {
            "speaker": "凌瑶",
            "text": "老范说在水里泡了半个时辰。大冷天泡那么久，上岸的时候总得有人瞧见他。"
          }
        ]
      },
      {
        "when": {
          "all": [
            {
              "flag": "self_cleared"
            },
            {
              "not": {
                "evidence": "evidence_float_bladder"
              }
            }
          ]
        },
        "lines": [
          {
            "speaker": "凌瑶",
            "text": "凿了船的人肯定给自己留了活路。浮囊是一个，还有没有别的。芦苇丛那边没看过。"
          }
        ]
      },
      {
        "when": {
          "all": [
            {
              "flag": "self_cleared"
            },
            {
              "not": {
                "evidence": "evidence_dismissal_note"
              }
            }
          ]
        },
        "lines": [
          {
            "speaker": "凌瑶",
            "text": "阿贵跟了十二年，突然下手。这事不说清楚说不通。"
          }
        ]
      },
      {
        "when": {
          "all": [
            {
              "evidence": "evidence_hull_hole"
            },
            {
              "evidence": "evidence_float_bladder"
            },
            {
              "evidence": "evidence_no_blunt_trauma"
            },
            {
              "clue": "clue_fan_alibi_hole"
            },
            {
              "evidence": "evidence_dismissal_note"
            }
          ]
        },
        "lines": [
          {
            "speaker": "凌瑶",
            "text": "差不多了。去把人叫到一块儿吧。"
          }
        ]
      },
      {
        "when": {
          "default": true
        },
        "lines": [
          {
            "speaker": "凌瑶",
            "text": "那条船底……你还想再看一眼吗？"
          },
          {
            "speaker": "陆昭",
            "text": "嗯。"
          },
          {
            "speaker": "凌瑶",
            "text": "好，我陪你去。"
          }
        ]
      }
    ]
  },
  "suspect_now": {
    "rules": [
      {
        "when": {
          "all": [
            {
              "flag": "agui_confessed_mastermind"
            },
            {
              "evidence": "evidence_father_ledger"
            }
          ]
        },
        "lines": [
          {
            "speaker": "凌瑶",
            "text": "沈姑娘……我看不透她。她一直是那个眼神，从头到尾没变过。"
          },
          {
            "speaker": "陆昭",
            "text": "她父亲病了，欠的债也是真的。"
          },
          {
            "speaker": "凌瑶",
            "text": "我知道。所以才看不透她。"
          }
        ]
      },
      {
        "when": {
          "flag": "agui_confessed_mastermind"
        },
        "lines": [
          {
            "speaker": "凌瑶",
            "text": "沈姑娘一个人坐在楼上，像在等什么。"
          }
        ]
      },
      {
        "when": {
          "all": [
            {
              "flag": "agui_premeditation_known"
            },
            {
              "flag": "fan_motive_known"
            }
          ]
        },
        "lines": [
          {
            "speaker": "凌瑶",
            "text": "阿贵身上那个浮囊。是别人给的。一个十六岁的仆从，哪儿来的钱。"
          },
          {
            "speaker": "陆昭",
            "text": "有人替他想好了后路。"
          },
          {
            "speaker": "凌瑶",
            "text": "嗯，所以那个人也知道船要沉。"
          }
        ]
      },
      {
        "when": {
          "all": [
            {
              "flag": "agui_premeditation_known"
            },
            {
              "flag": "fan_talked_once"
            }
          ]
        },
        "lines": [
          {
            "speaker": "凌瑶",
            "text": "阿贵和老范。感觉是被同一件事堵进来的。"
          }
        ]
      },
      {
        "when": {
          "flag": "agui_premeditation_known"
        },
        "lines": [
          {
            "speaker": "凌瑶",
            "text": "阿贵之前一直盯着那个包袱，话却说得很顺溜。"
          },
          {
            "speaker": "陆昭",
            "text": "顺溜到不像临时想出来的。"
          }
        ]
      },
      {
        "when": {
          "all": [
            {
              "flag": "hull_sabotage_known"
            },
            {
              "flag": "fan_talked_once"
            }
          ]
        },
        "lines": [
          {
            "speaker": "凌瑶",
            "text": "老范……他走东汊，说南汊堵了。可昨天停在渡口的船里，有两条是从南汊来的。"
          }
        ]
      },
      {
        "when": {
          "flag": "hull_sabotage_known"
        },
        "lines": [
          {
            "speaker": "凌瑶",
            "text": "同船三个人，死的是最会水的。活下来的说自己不会水。"
          },
          {
            "speaker": "陆昭",
            "text": "嗯。"
          },
          {
            "speaker": "凌瑶",
            "text": "这说不通。"
          }
        ]
      },
      {
        "when": {
          "all": [
            {
              "flag": "fan_talked_once"
            },
            {
              "flag": "agui_talked_once"
            }
          ]
        },
        "lines": [
          {
            "speaker": "凌瑶",
            "text": "老范和阿贵，哪个先知道船会沉？"
          },
          {
            "speaker": "陆昭",
            "text": "……或者两个都知道。"
          },
          {
            "speaker": "凌瑶",
            "text": "可两个人凑在一起策划这种事，需要有个人牵线。"
          }
        ]
      },
      {
        "when": {
          "flag": "fan_talked_once"
        },
        "lines": [
          {
            "speaker": "凌瑶",
            "text": "老范太稳了。船刚沉，死了人，他说话不乱。"
          }
        ]
      },
      {
        "when": {
          "flag": "agui_talked_once"
        },
        "lines": [
          {
            "speaker": "凌瑶",
            "text": "阿贵怕得真实。可那些话像提前想好的。怕的是露馅，不是说错了。"
          }
        ]
      },
      {
        "when": {
          "default": true
        },
        "lines": [
          {
            "speaker": "凌瑶",
            "text": "现在说不好。"
          },
          {
            "speaker": "陆昭",
            "text": "嗯。"
          },
          {
            "speaker": "凌瑶",
            "text": "那就一个个问。"
          }
        ]
      }
    ]
  },
  "evidence_ready": {
    "rules": [
      {
