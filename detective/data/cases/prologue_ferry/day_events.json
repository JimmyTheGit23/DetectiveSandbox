        {
          "speaker": "凌瑶",
          "text": "（阿贵明明说自己不会水……却把这能浮水的牛皮囊藏在包袱最底下。他在防着谁？）",
          "emotion": "inner_thought"
        }
      ],
      "effects": {
        "set_flag": [
          "evt_bladder_found_done",
          "agui_premeditation_known"
        ]
      }
    },
    {
      "id": "evt_dismissal_revealed",
      "title": "二两遣散银",
      "hint": "（你发现了遣散字据）",
      "trigger": {
