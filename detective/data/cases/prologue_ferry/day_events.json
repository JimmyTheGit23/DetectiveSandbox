{
  "_comment": "序章日程事件。教学案较少事件，主要用于推进节奏和教学。",
  "events": [
    {
      "id": "evt_cabin_return_to_room",
      "title": "整理疑点",
      "hint": "（你回到了自己的舱室。雨声不停，风越来越大。该把船舱里的异常先记下来。）",
      "trigger": {
        "all": [
          {
            "location": "cabin_lu_room"
          },
          {
            "flag": "cabin_seal_box_checked"
          },
          {
            "flag": "cabin_route_note_checked"
          },
          {
            "any": [
              {
                "flag": "cabin_agui_talked"
              },
              {
                "flag": "cabin_lao_fan_talked"
              },
              {
                "flag": "cabin_zhou_talked"
              }
            ]
          },
          {
            "not": {
              "flag": "cabin_review_done"
            }
          },
          {
            "not": {
              "flag": "cabin_phase_done"
            }
          }
        ]
      },
      "narration": [
        {
          "speaker": "陆昭",
          "text": "回舱。把刚才听到的几句话先按住。",
          "emotion": "inner_thought"
        },
        {
          "speaker": "陆昭",
          "text": "周德茂的铜锁箱。阿贵的包袱。老范那句别开窗。三样东西都不该同时让我不安。",
          "emotion": "inner_thought"
        },
        {
          "speaker": "陆昭",
          "text": "先睡不成了。再听一会儿水声。",
          "emotion": "anxious"
        }
      ],
      "effects": {
        "set_flag": [
          "cabin_review_prompted",
          "cabin_review_done"
        ]
      },
      "auto_play": true,
      "_comment": "检查官印木匣、行程简记并至少问过一名船上人后回房，播放陆昭短推理收束。"
    },
    {
      "id": "evt_cabin_sinking",
      "title": "沉船惊变",
      "hint": "夜深了。雨声越来越重。",
      "trigger": {
        "all": [
          {
            "flag": "cabin_review_done"
          },
          {
            "not": {
              "flag": "evt_cabin_sinking_done"
            }
          },
          {
            "not": {
              "flag": "accused_of_murder"
            }
          }
        ]
      },
      "narration": [
        {
          "speaker": "陆昭",
          "text": "（夜深。船舱只剩半盏油灯。雨敲在船篷上，像有人隔着木板细细敲门。）",
          "emotion": "inner_thought",
          "background": "res://assets/cn/scenes/prologue_ship_cabin_lu_room.png",
          "effect": {
            "cabin_escape_panel": true
          }
        },
        {
          "speaker": "陆昭",
          "text": "水声不对。",
          "emotion": "inner_thought"
        },
        {
          "speaker": "陆昭",
          "text": "（船底忽然传来一声闷响。下一瞬，地板从脚下歪过去。）",
          "emotion": "inner_thought",
          "background": "res://assets/cn/scenes/prologue_ship_cabin_night.png"
        },
        {
          "speaker": "陆昭",
          "text": "官印匣！",
          "emotion": "panic"
        },
        {
          "speaker": "陆昭",
          "text": "（冷水从底舱缝里冲上来。灯灭了，四周只剩木头断裂和人喊人的声音。）",
          "emotion": "inner_thought"
        },
        {
          "speaker": "陆昭",
          "text": "水太急……什么都抓不住……",
          "emotion": "panic"
        },
        {
          "speaker": "陆昭",
          "text": "（水压像一只手按住胸口。摸到天窗边的铁器，狠狠撬了一下。）",
          "emotion": "inner_thought"
        },
        {
          "speaker": "陆昭",
          "text": "（木栓断开。江水裹着人撞出船舱，夜色和浪一起压下来。）",
          "emotion": "inner_thought",
          "background": "res://assets/cn/scenes/prologue_shore_rescue.png",
          "effect": {
            "bgm": "ferry_prologue_shore"
          }
        },
        {
          "speaker": "凌瑶",
          "text": "抓住我！别松手！",
          "emotion": "determined",
          "background": "res://assets/cn/scenes/prologue_cg_lingyao_meets_luzhao.png"
        },
        {
          "speaker": "陆昭",
          "text": "（有人从水里扣住手腕。那只手很稳，把人从冰冷里硬拽出来。）",
          "emotion": "inner_thought"
        },
        {
          "speaker": "陆昭",
          "text": "（石矶渡客栈。火盆噼啪作响。醒来时，喉咙里全是江水的腥味。）",
          "emotion": "inner_thought",
          "background": "res://assets/cn/scenes/prologue_ferry_inn_aftermath.png",
          "effect": {
            "bgm": "ferry_inn_investigation"
          }
        },
        {
          "speaker": "凌瑶",
          "text": "别急着起。你刚才连咳都咳不出来。",
          "emotion": "concerned"
        },
        {
          "speaker": "陆昭",
          "text": "我的官印匣呢？",
          "emotion": "panic"
        },
        {
          "speaker": "凌瑶",
          "text": "我捞的是人，不是木匣。你先活着。",
          "emotion": "serious"
        },
        {
          "speaker": "陆昭",
          "text": "……陆昭。",
          "emotion": "vulnerable"
        },
        {
          "speaker": "凌瑶",
          "text": "凌瑶。金鳞镖局。路过这里押一封急件，顺手捞了个人。",
          "emotion": "determined",
          "effect": {
            "gain_evidence": "evidence_lingyao_identity"
          }
        },
        {
          "speaker": "陆昭",
          "text": "（天刚亮，下游浅滩又抬回来一具尸首。湿衣贴在身上，脸已经青了。）",
          "emotion": "inner_thought",
          "background": "res://assets/cn/scenes/prologue_ferry_dock.png",
          "effect": {
            "bgm": "ferry_dock_investigation"
          }
        },
        {
          "speaker": "陆昭",
          "text": "周德茂死了？",
          "emotion": "shaken"
        },
        {
          "speaker": "凌瑶",
          "text": "阿贵和老范都没事。可那个周老板……掌柜说明明他最懂水性，怎么偏偏是他没上来？",
          "emotion": "worried"
        },
        {
          "speaker": "周氏",
          "text": "昨夜他还在说武昌的货，今天就躺在这儿。到底是谁……",
          "emotion": "grief",
          "background": "res://assets/cn/scenes/prologue_cg_zhou_kneel.png"
        },
        {
          "speaker": "阿贵",
          "text": "夫人……小的看见陆公子在底舱口。手里，像拿着铁的东西。",
          "emotion": "nervous"
        },
        {
          "speaker": "陆昭",
          "text": "那是我撬天窗逃命用的。",
          "emotion": "gentle"
        },
        {
          "speaker": "老范",
          "text": "我没看清谁害谁。可船翻前，舱里确实有铁碰木头的声儿。",
          "emotion": "nervous"
        },
        {
          "speaker": "周氏",
          "text": "一个说没看清，一个说只为逃命。可我老爷死了，你活着。",
          "emotion": "accusing"
        },
        {
          "speaker": "陆昭",
          "text": "（人群后方……沈清月没有往前挤。她只抬了抬眼。）",
          "emotion": "inner_thought"
        },
        {
          "speaker": "沈清月",
          "text": "先别乱。阿贵既说看见了，就把话说细些，是哪只手，拿的又是哪件铁器？",
          "emotion": "calm"
        },
        {
          "speaker": "沈清月",
          "text": "还有陆公子这话，我倒有些听不明白。船上当时乱成那样，你怎么就知道，是船底先进的水？",
          "emotion": "calm"
        },
        {
          "speaker": "凌瑶",
          "text": "他刚从江里捞回来，话都没喘匀。你倒问得稳。",
          "emotion": "angry"
        },
        {
          "speaker": "钱里正",
          "text": "哎呀，都少说两句！人命在这儿呢，这会儿谁也别先把话钉死嘛。",
          "emotion": "stern"
        },
        {
          "speaker": "钱里正",
          "text": "陆公子，小人斗胆说句公道话，您眼下也脱不了干系呵。先移步客栈堂上，把看见的听见的，慢慢说清嘛。",
          "emotion": "stern",
          "effect": {
            "bgm": "ferry_confrontation"
          }
        },
        {
          "speaker": "陆昭",
          "text": "我没害周德茂。",
          "emotion": "gentle"
        },
        {
          "speaker": "凌瑶",
          "text": "那就查。陆昭，我信你。他们怎么说的不算，咱们自己去看。",
          "emotion": "determined"
        },
        {
          "speaker": "陆昭",
          "text": "（王大爷被人从门边请出来。搓着冻红的手，眼神直往地上躲。）",
          "emotion": "inner_thought"
        }
      ],
      "effects": {
        "set_flag": [
          "evt_cabin_sinking_done",
          "evt_cabin_sleep_done",
          "cabin_explore_done",
          "cabin_phase_done",
          "accused_of_murder"
        ],
        "change_location": "ferry_inn",
        "defer_change_location": true,
        "suppress_arrival_banter": true,
        "suppress_location_intro": true,
        "auto_start_confrontation": "confrontation_wang",
        "narration_fx": {
