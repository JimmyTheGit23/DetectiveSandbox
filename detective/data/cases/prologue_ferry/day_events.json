          "emotion": "gentle"
        }
      ],
      "effects": {
        "set_flag": [
          "evt_gambling_debt_done",
          "fan_motive_known"
        ]
      }
    },
    {
      "id": "evt_quiet_moment",
      "title": "馒头",
      "trigger": {
        "all": [
          {
            "evidence_count_gte": 2
          },
          {
