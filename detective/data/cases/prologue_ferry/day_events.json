      "narration": [
        {
          "speaker": "陆昭",
          "text": "洞口边缘太齐。木刺朝外……不像撞进去，像从里头开出来。",
          "emotion": "gentle"
        },
        {
          "speaker": "凌瑶",
          "text": "要是撞上了暗礁，船底下不该只有这么一个整整齐齐的窟窿。",
          "emotion": "determined"
        },
        {
          "speaker": "陆昭",
          "text": "有人凿的。从舱内往外。",
          "emotion": "gentle"
        }
      ],
      "effects": {
        "set_flag": [
          "evt_hull_discovered_done",
          "hull_sabotage_known"
        ]
      }
    },
    {
      "id": "evt_bladder_found",
      "title": "预谋逃生",
      "hint": "（你在沉船下游的芦苇丛中发现了阿贵的包袱和浮囊）",
      "trigger": {
        "all": [
          {
            "evidence": "evidence_float_bladder"
