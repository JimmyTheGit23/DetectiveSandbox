            }
          },
          {
            "not": {
              "flag": "accused_of_murder"
            }
          }
        ]
      },
      "narration": [
        {
          "speaker": "陆昭",
          "text": "（客栈房间。火盆还亮着，窗纸被雨吹得发白。）",
          "emotion": "inner_thought"
        },
        {
          "speaker": "凌瑶",
          "text": "你醒了就别乱动。掌柜说你刚才冻得牙都合不上。",
          "emotion": "gentle"
        },
        {
          "speaker": "陆昭",
          "text": "我欠你一条命。",
          "emotion": "vulnerable"
        },
        {
          "speaker": "凌瑶",
          "text": "记账可以，先活过今晚。你到底惹上什么事，等能坐稳了再说。",
          "emotion": "serious"
        }
      ],
      "effects": {
        "set_flag": [
          "evt_inn_recovery_done"
        ]
      },
      "auto_play": true,
      "_comment": "凌瑶救人后客栈深夜独处：官印沉江、身份模糊、信任建立——在 evt_cabin_sinking 之后、清晨指控之前触发。"
    },
    {
      "id": "evt_self_cleared",
      "title": "自证清白",
      "hint": "王大爷的证词被推翻",
      "trigger": {
        "all": [
          {
            "flag": "confrontation_wang_completed"
          },
          {
            "not": {
              "flag": "self_cleared"
            }
          }
        ]
      },
      "narration": [
        {
          "speaker": "钱里正",
          "text": "不至于不至于……王大爷这话嘛，怕是不能再当铁证了。陆公子，这一层小人记下了，记下了呵。",
          "emotion": "stern"
        },
        {
          "speaker": "凌瑶",
          "text": "你的嫌疑是洗干净了，可这案子还没完呢，凶手还在暗处盯着咱们呢。",
          "emotion": "determined"
        },
        {
          "speaker": "陆昭",
          "text": "去看船。阿贵和老范的话，都得落到木板上。",
          "emotion": "gentle"
        }
      ],
      "effects": {
        "set_flag": [
          "self_cleared"
        ]
      },
      "_comment": "王大爷对峙完成后"
    },
    {
      "id": "evt_hull_discovered",
      "title": "人为破坏",
      "hint": "（你发现了船底的人工破洞）",
      "trigger": {
        "all": [
          {
            "flag": "self_cleared"
          },
          {
            "any": [
              {
                "location": "ferry_dock"
              },
              {
