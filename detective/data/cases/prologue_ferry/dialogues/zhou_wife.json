    "ask_documents": {
      "text": "都在房间里。陆公子自己去看吧——遣散字据、货单都在桌上。\n\n（她指了指房间的方向。）",
      "emotion": "relieved",
      "lines": [
        {
          "text": "都在房间里。陆公子自己去看吧——遣散字据、货单都在桌上。",
          "speaker_id": "zhou_wife",
          "emotion": "suspicious"
        },
        {
          "text": "多谢。",
          "speaker_id": "lu_zhao",
          "emotion": "serious"
        },
        {
          "text": "多谢。",
          "speaker_id": "lu_zhao",
