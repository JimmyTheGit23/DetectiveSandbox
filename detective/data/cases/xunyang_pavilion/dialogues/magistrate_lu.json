{
  "start": "intro",
  "nodes": {
    "intro": {
      "text": "（鲁知府捻须）陆大人远来辛苦。这案子本府已经查过——醉酒失足，证据明白。大人不必费心。",
      "options": [
        {
          "text": "栏杆上有指甲挣痕。",
          "goto": "argue_railing",
          "hide_after_visit": true
        },
        {
          "text": "红绸断口方向不对。",
          "goto": "argue_silk",
          "hide_after_visit": true
        },
        {
          "text": "有目击者看到阁中两人。",
          "goto": "argue_witness",
          "requires": {
            "evidence": "evidence_witness_lantern"
          },
          "hide_after_visit": true
        },
        {
          "text": "（先告辞）",
          "goto": "__exit__"
        }
      ]
    },
    "argue_railing": {
      "text": "（眉头微皱）……指甲痕？本府再看看。但这也可能是她抓栏时留下的——不算定论。",
      "options": [
        {
          "text": "（先记下）",
          "goto": "intro"
        }
      ]
    },
    "argue_silk": {
      "text": "（脸色微变）……这红绸的断口确实不像失足。罢罢，本府改'存疑'二字，等大人再查三日。",
      "set_flags": [
        "lu_grudgingly_open"
      ],
      "options": [
        {
          "text": "（先告辞）",
          "goto": "__exit__"
        }
      ]
    },
    "argue_witness": {
      "text": "（沉默良久）阁中有第二人——那便不是失足了。本府这就把结案稿撕了。陆大人，这桩案子交予您。",
      "set_flags": [
        "lu_yielded"
      ],
      "options": [
        {
          "text": "（先告辞）",
          "goto": "__exit__"
        }
      ]
    }
  }
}
